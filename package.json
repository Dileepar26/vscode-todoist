{
  "name": "vscode-todoist",
  "displayName": "Tasks for Todoist",
  "description": "View and manage your Todoist tasks directly in VS Code (unofficial)",
  "version": "0.0.1",
  "publisher": "dileepar26",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dileepar26/vscode-todoist.git"
  },
  "bugs": {
    "url": "https://github.com/Dileepar26/vscode-todoist/issues"
  },
  "homepage": "https://github.com/Dileepar26/vscode-todoist#readme",
  "keywords": [
    "todoist",
    "tasks",
    "todo",
    "productivity"
  ],
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todoist-sidebar",
          "title": "Todoist",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "todoist-sidebar": [
        {
          "id": "todoistTodayView",
          "name": "Today"
        },
        {
          "id": "todoistUpcomingView",
          "name": "Upcoming",
          "visibility": "collapsed"
        },
        {
          "id": "todoistInboxView",
          "name": "Inbox",
          "visibility": "collapsed"
        },
        {
          "id": "todoistProjectsView",
          "name": "Projects",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "todoistTodayView",
        "contents": "Connect your Todoist account to see today's tasks.\n[Set API Token](command:todoist.setToken)",
        "when": "!todoist.hasToken"
      },
      {
        "view": "todoistTodayView",
        "contents": "Nothing due today or overdue.\n[Add Task](command:todoist.addTask)",
        "when": "todoist.hasToken"
      }
    ],
    "commands": [
      {
        "command": "todoist.setToken",
        "title": "Todoist: Set API Token"
      },
      {
        "command": "todoist.refresh",
        "title": "Todoist: Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "todoist.addTask",
        "title": "Todoist: Quick Add Task",
        "icon": "$(add)"
      },
      {
        "command": "todoist.completeTask",
        "title": "Complete Task",
        "icon": "$(check)"
      },
      {
        "command": "todoist.editTask",
        "title": "Edit Task",
        "icon": "$(edit)"
      },
      {
        "command": "todoist.rescheduleTask",
        "title": "Reschedule Task",
        "icon": "$(calendar)"
      },
      {
        "command": "todoist.deleteTask",
        "title": "Delete Task",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "todoist.addTask",
          "when": "view =~ /^todoist.*View$/",
          "group": "navigation@1"
        },
        {
          "command": "todoist.refresh",
          "when": "view =~ /^todoist.*View$/",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "todoist.completeTask",
          "when": "viewItem == todoistTask",
          "group": "inline@1"
        },
        {
          "command": "todoist.editTask",
          "when": "viewItem == todoistTask",
          "group": "1_modify@1"
        },
        {
          "command": "todoist.rescheduleTask",
          "when": "viewItem == todoistTask",
          "group": "1_modify@2"
        },
        {
          "command": "todoist.deleteTask",
          "when": "viewItem == todoistTask",
          "group": "9_danger"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@doist/todoist-sdk": "^15.13.1"
  }
}
